<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_outside_new_model_form" model="ir.ui.view">
        <field name="name">outside.new.model.form</field>
        <field name="model">outside.new.model</field>
        <field name="arch" type="xml">
            <form string="Outside Record">
                <header>
                    <button name="%(practice.demo_report)d"
                            string="Download Custom PDF"
                            type="action"
                            class="oe_highlight"/>
                </header>
                <sheet>
                    <field name="image" widget="image" class="oe_avatar" options="{'size': [90, 90]}"/>
                    <div class="oe_title">
                        <label for="name" string="Full Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Erdenee"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Contact Information">
                            <field name="email" widget="email"/>
                            <field name="phone" widget="phone"/>
                            <field name="address"/>
                        </group>
                        <group string="Other Details">
                            <field name="age"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="About Profile" name="about_profile">
                            <field name="about" placeholder="Describe this profile..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
