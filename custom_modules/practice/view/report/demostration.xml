<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="paperformat_zero_margin" model="report.paperformat">
        <field name="name">Zero Margin A4</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
    </record>

    <record id="demo_report" model="ir.actions.report">
        <field name="name">Custom PDF Report</field>
        <field name="model">outside.new.model</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">practice.demo_custom_template</field>
        <field name="report_file">practice.demo_custom_template</field>
        <field name="binding_model_id" ref="model_outside_new_model"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_zero_margin"/>
    </record>

    <template id="demo_custom_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="page" style="font-family: 'Helvetica', 'Arial', sans-serif; padding: 40px; color: #333;">
                    <div style="border-bottom: 3px solid #714B67; padding-bottom: 10px; margin-bottom: 30px;">
                        <h1 style="margin: 0; color: #714B67;">CUSTOM PROFILE REPORT</h1>
                        <span style="color: #666;">Generated on Odoo 18</span>
                    </div>

                    <table style="width: 100%; border-collapse: collapse; margin-bottom: 20px;">
                        <tr>
                            <td style="width: 30%; padding: 10px; font-weight: bold; background: #f5f5f5; border: 1px solid #ddd;">Name:</td>
                            <td style="padding: 10px; border: 1px solid #ddd;"><t t-out="doc.name"/></td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; font-weight: bold; background: #f5f5f5; border: 1px solid #ddd;">Email:</td>
                            <td style="padding: 10px; border: 1px solid #ddd;"><t t-out="doc.email"/></td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; font-weight: bold; background: #f5f5f5; border: 1px solid #ddd;">Phone:</td>
                            <td style="padding: 10px; border: 1px solid #ddd;"><t t-out="doc.phone"/></td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; font-weight: bold; background: #f5f5f5; border: 1px solid #ddd;">Address:</td>
                            <td style="padding: 10px; border: 1px solid #ddd;"><t t-out="doc.address"/></td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; font-weight: bold; background: #f5f5f5; border: 1px solid #ddd;">Age:</td>
                            <td style="padding: 10px; border: 1px solid #ddd;"><t t-out="doc.age"/></td>
                        </tr>
                    </table>

                    <div style="margin-top: 20px;">
                        <h3>About:</h3>
                        <div style="border: 1px solid #eee; padding: 15px; border-radius: 4px;">
                            <t t-out="doc.about"/>
                        </div>
                    </div>

                    <img t-att-src="'/practice/static/description/appstoreqr.png'"
                     style="width: 110px; height: 110px;"
                     alt="App Store Static Asset"/>

                </div>
            </t>
        </t>
    </template>
</odoo>