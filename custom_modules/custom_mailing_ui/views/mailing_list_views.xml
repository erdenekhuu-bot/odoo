<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_mailing_list_tree_custom" model="ir.ui.view">
        <field name="name">mailing.list.tree.custom</field>
        <field name="model">mailing.list</field>
        <field name="arch" type="xml">
          <tree>
            <field name="name"/>
            <field name="is_public"/>
          </tree>
        </field>
      </record>

      <record id="view_mailing_list_form_custom" model="ir.ui.view">
        <field name="name">mailing.list.form.custom</field>
        <field name="model">mailing.list</field>
        <field name="arch" type="xml">
          <form>
            <sheet>
              <group>
                <field name="name"/>
                <field name="is_public"/>
              </group>
            </sheet>
          </form>
        </field>
      </record>

      <record id="action_mailing_list_custom" model="ir.actions.act_window">
        <field name="name">Mailing Lists</field>
        <field name="res_model">mailing.list</field>
        <field name="view_mode">tree,form</field>
      </record>

      <menuitem id="menu_mailing_list_custom"
            name="Mailing Lists"
            parent="mass_mailing.mass_mailing_menu"
            action="action_mailing_list_custom"/>
</odoo>