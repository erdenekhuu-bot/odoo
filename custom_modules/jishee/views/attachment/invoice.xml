<odoo>
    <template id="attachment_pdf_invoice">
        <t t-call="web.html_container">
            <style>
                @page {
                    size: A4 portrait;
                    margin: 7mm 6mm 8mm 6mm;
                }

                * {
                    box-sizing: border-box;
                    -webkit-print-color-adjust: exact !important;
                    print-color-adjust: exact !important;
                }

                html, body {
                    background: #ffffff;
                    color: #111111;
                    font-family: Arial, Helvetica, sans-serif;
                }

                .invoice-header {
                    display: grid;
                    grid-template-columns: 1fr 34mm;
                    align-items: start;
                    column-gap: 6mm;
                    border-bottom: 1mm solid #e0a51b;
                    padding: 0 0 4mm 0;
                    margin: 0 0 2.5mm 0;
                }

                .logo {
                    width: 31mm;
                    height: auto;
                    display: block;
                    margin-left: auto;
                }

                .invoice-main {
                    display: grid;
                    grid-template-columns: 1fr 1fr;
                }

                .left-panel {
                    padding-right: 6.5mm;
                    border-right: 0.5mm solid #d9a321;
                    min-height: 228mm;
                }

                .right-panel {
                    padding-left: 6.5mm;
                    min-height: 228mm;
                }

                .qr-row {
                    display: flex;
                    gap: 10px;
                    justify-content: center;
                    margin-top: 1mm;
                }

                .guide-images {
                    display: flex;
                    align-items: center;
                    gap: 5px;
                }
            </style>

            <t t-call="web.external_layout">
                <div class="page">
                    <header class="invoice-header">
                        <h1>20**.** САРЫН ТӨЛБӨРИЙН НЭХЭМЖЛЭХ</h1>
                        <img src="/jishee/static/src/img/banner.png" class="logo"/>
                    </header>

                    <main class="invoice-main">
                        <section class="left-panel">1</section>
                        <section class="right-panel">2</section>
                    </main>
                </div>
            </t>
        </t>
    </template>
</odoo>