<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="model_name_view_tree" model="ir.ui.view">
        <field name="name">mailing.list.view.list</field>
        <field name="model">mailing.list</field>
        <field name="arch" type="xml">
            <list string="">
                <field name="name" />
                <field name="email"/>
                <field name="active"/>
                <field name="is_public"/>
            </list>
        </field>
    </record>

    <record id="model_name_view_form" model="ir.ui.view">
        <field name="name">mailing.list.view.form</field>
        <field name="model">mailing.list</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="email"/>
                        <field name="active"/>
                        <field name="is_public"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="model_name_action" model="ir.actions.act_window">
        <field name="name">Action Name</field>
        <field name="res_model">mailing.list</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="contact_action" model="ir.actions.act_window">
        <field name="name">Action Name</field>
        <field name="res_model">mailing.contact</field>
        <field name="view_mode">list,form</field>
       
    </record>


    <menuitem
        id="parent"
        name="MAIL LIST"
        sequence="10"/>

        <menuitem
        id="mail_l"
        name="mail list"
        action="model_name_action"
        parent="parent"
        />

        <menuitem
            id="mail_c"
            name="mail contact"
            action="contact_action"
            parent="parent"
            />
</odoo>