<?xml version='1.0' encoding='utf-8'?>
<odoo>
        <record id="shine_addon_view_tree" model="ir.ui.view">
            <field name="name">shine.addon.list</field>
            <field name="model">shine.addon</field>
            <field name="arch" type="xml">
                <list string="">
                    <field name="addons_name" />
                    <field name="addons_description"/>
                    <field name="addons_category"/>
                </list>
            </field>
        </record>

        <record id="shine_addon_view_form" model="ir.ui.view">
            <field name="name">shine.addon.form</field>
            <field name="model">shine.addon</field>
            <field name="arch" type="xml">
                <form string="">
                    <sheet>
                        <group>
                            <field name="addons_name" />
                            <field name="addons_description"/>
                            <field name="addons_category"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="shine_addon_action" model="ir.actions.act_window">
            <field name="name">Shine app</field>
            <field name="res_model">shine.addon</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="shine_app" name="Shine app" sequence="2"/>

        <menuitem id="model_name_menu" name="Addon uusgeh" action="shine_addon_action" parent="shine_app"/>
</odoo>