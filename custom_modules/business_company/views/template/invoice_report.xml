<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="paperformat_non_margin" model="report.paperformat">
        <field name="name">Zero Margin A4</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
    </record>

    <record id="final_report_pdf" model="ir.actions.report">
        <field name="name">Custom PDF Report</field>
        <field name="model">billing.read</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">business_company.demo_custom_template</field>
        <field name="report_file">business_company.demo_custom_template</field>
        <field name="binding_model_id" ref="model_billing_read"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_non_margin"/>
    </record>

   <template id="demo_custom_template">
    <t t-call="web.html_container">
        <meta charset="UTF-8" />
        <style>
            @page {
                size: A4 portrait;
                margin: 0mm;
            }
            body {
                font-family: 'Arial', sans-serif;
                font-size: 12px;
                color: #333333;
                margin: 0;
                padding: 0;
            }
            .page-container {
                position: relative;
                width: 100%;
                box-sizing: border-box;
                padding: 20px 50px 100px 50px; /* Bottom padding prevents text overlap with footer */
            }
            .footer-fixed {
                position: fixed;
                bottom: 15px;
                left: 50px;
                right: 50px;
                width: calc(100% - 100px);
                background: #ffffff;
            }
        </style>

        <div class="page page-container">
            <!-- Top Header Bar -->
            <table style="width: 100%; border-bottom: 2px solid #f6b500; padding-bottom: 5px; margin-bottom: 5px;">
               <tr>
                    <td style="text-align: left; vertical-align: middle; padding: 2px 0;">
                       <h1 style="font-size: 16px; font-weight: bold; color: #4a4a4a; margin: 0;">
                            <t t-out="env.context.get('datetimes')"/> САРЫН ТӨЛБӨРИЙН НЭХЭМЖЛЭЛ
                        </h1>
                    </td>
                    <td style="text-align: right; vertical-align: middle; padding: 2px 0;">
                      <img t-att-src="'data:image/png;base64,%s' % env.context.get('logo_b64')" width="140px" alt=""/>
                    </td>
                </tr>
            </table>

            <main>
            <!--Хувийн мэдээлэл-->
               <table
                    cellpadding="0"
                    cellspacing="0"
                    border="0"
                    style="
                      width: 65%;
                      margin: 2px auto;
                      border-collapse: collapse;
                      font-size: 14px;
                    "
                  >
                   <tr>
                      <td style="padding: 2px 0;">Нэхэмжлэхийн дугаар:</td>
                      <td style="text-align: right;">
                       <t t-out="env.context.get('profile').subs_id"/>
                      </td>
                    </tr>
                    <tr>
                      <td style="padding: 2px 0;">Хамрагдах хугацаа:</td>
                      <td style="text-align: right">
                        <t t-out="env.context.get('date_create')"/>
                      </td>
                    </tr>
                    <tr>
                      <td style="padding: 2px 0;">
                        Төлбөрийг нэхэмжлэх хугацаа:
                      </td>
                      <td style="text-align: right">
                          <t t-out="env.context.get('period_start')"/>
                      </td>
                    </tr>
                    <tr>
                      <td style="padding: 2px 0;">
                        Төлбөр хийх эцсийн хугацаа:
                      </td>
                      <td style="text-align: right">
                          <t t-out="env.context.get('period_end')"/>
                      </td>
                    </tr>
                    <tr>
                      <td style="padding: 2px 0;">Хэрэглэгчийн нэр:</td>
                      <td style="text-align: right;">
                        <t t-out="env.context.get('profile').cust_name"/>
                      </td>
                    </tr>
                    <tr>
                      <td style="padding: 2px 0;">Гэрээний дугаар:</td>
                      <td style="text-align: right">
                           <t t-out="env.context.get('profile').acc_id"/>
                      </td>
                    </tr>
                    <tr>
                      <td style="padding: 2px 0;">Утасны дугаар:</td>
                      <td style="text-align: right">
                          <t t-out="env.context.get('profile').acc_number"/>
                      </td>
                    </tr>
               </table>
                <table
                    cellpadding="0"
                    cellspacing="0"
                    border="0"
                    style="
                      width: 100%;
                      border-collapse: collapse;
                      background: #fbb515;
                      border-radius: 12px;
                      overflow: hidden;
                      margin-bottom: 5px;
                    "
                  >
                    <tr>
                      <td
                        style="
                          width: 61%;
                          text-align: end;
                          font-weight: bold;
                          padding: 2px 12px;
                        "
                      >
                        ХЭМЖЭЭ / ХУГАЦАА
                      </td>
                      <td
                        style="
                          width: 39%;
                          text-align: center;
                          font-weight: bold;
                          padding: 4px 0;
                        "
                      >
                        ДҮН
                      </td>
                    </tr>
              </table>

                <!--Багц, хэрэглээ-->
                <table
                    cellpadding="0"
                    cellspacing="0"
                    border="0"
                    style="width: 70%; margin: 8px auto;border-collapse: collapse;font-size: 14px;"
                  >
                    <tr>
                          <td colspan="2" style="padding: 2px 0; font-weight: bold;">
                            БАГЦАД ДАГАЛДАХ ЭРХ:
                          </td>
                        </tr>
                        <t t-foreach="env.context.get('head_data', [])" t-as="item">
                            <tr>
                                <td style="width: 50%; padding: 0 22px;">
                                    <span t-out="item.get('name','')"/>
                                </td>
                                <td style="width: 25%; padding: 1px 0;">
                                    <span t-out="item.get('description','')"/>
                                </td>

                                <td style="width: 25%; padding: 0 22px; text-align:end;">
                                    <span t-out="'{:,.2f}'.format(item.get(amount,0))"/>
                                </td>
                            </tr>
                        </t>
                       <td colspan="2" style="padding: 3px 0 2px 0; font-weight: bold">
                            НЭМЭЛТ ХЭРЭГЛЭЭ
                          </td>
                        <t t-foreach="env.context.get('data', [])" t-as="item">
                            <tr>
                              <td style="width: 50%; padding: 0 22px;">
                                 <span t-out="item.get('item_type')"/>
                              </td>
                              <td style="width: 25%; padding: 1px 0;">
                                  <span
                                    t-if="item.get('limit') not in (0, 0.0, '0', '0.0', '', None)"
                                    t-out="item.get('limit')"
                                />
                              </td>
                              <td style="width: 25%; padding: 0 22px; text-align: end;">
                                   <span t-out="'{:,.2f}'.format(item.get(amount,0))"/>
                              </td>
                            </tr>
                        </t>
                  </table>

                <!--Сарын төлбөр-->
                <table
                    cellpadding="0"
                    cellspacing="0"
                    border="0"
                    style="
                      width: 100%;
                      border-collapse: collapse;
                      background: #fbb515;
                      border-radius: 12px;
                      overflow: hidden;
                      margin-bottom: 5px;
                      font-size: 14px;
                      margin: 8px auto;
                    "
                  >
                    <tr>
                      <td style="padding: 4px 15%; font-weight: bold">
                        ТУХАЙН САРЫН ТӨЛБӨР:
                      </td>
                    </tr>

                  </table>

                <t t-set="total_amount"
                   t-value="float(docs.env.context.get('total_amount'))"/>
                <t t-set="before_tax" t-value="total_amount / 1.1"/>
                <t t-set="vat_amount" t-value="total_amount * 0.1"/>

                <table
                    cellpadding="0"
                    cellspacing="0"
                    border="0"
                    style="
                      width: 70%;
                      margin: 0 auto 4px auto;
                      border-collapse: collapse;
                      font-size: 14px;
                    "
                  >
                    <tr>
                      <td style="width: 80%; padding: 0 22px;">Татвар тооцоогүй дүн</td>
                      <td style="padding: 1px 20px; text-align: end;">
                          <span t-out="'{:,.2f}'.format(before_tax)"/>
                      </td>
                    </tr>
                    <tr>
                      <td style="width: 80%; padding: 0 22px;">НӨАТ /10%/</td>
                      <td style="padding: 1px 20px; text-align: end;">
                          <span t-out="'{:,.2f}'.format(vat_amount)"/>
                      </td>
                    </tr>
                    <tr>
                      <td style="width: 80%; padding: 0 22px; font-weight: bold">Дүн</td>
                      <td style="padding: 1px 20px; text-align: end;">
                           <span t-out="'{:,.2f}'.format(total_amount)"/>
                      </td>
                    </tr>
                  </table>

                <table
                    cellpadding="0"
                    cellspacing="0"
                    border="0"
                    style="
                      width: 100%;
                      border-collapse: collapse;
                      background: #fbb515;
                      border-radius: 12px;
                      overflow: hidden;
                      margin-bottom: 5px;
                      font-size: 14px;
                    "
                  >
                    <tr>
                      <td style="padding: 4px 15%; font-weight: bold">
                        ТӨЛБӨР ЗОХИХ ДҮН
                      </td>
                    </tr>
                  </table>

                <table
                    cellpadding="0"
                    cellspacing="0"
                    border="0"
                    style="
                      width: 65.5%;
                      margin: 0 auto 10px auto;
                      border-collapse: collapse;
                      font-size: 14px;
                    "
                  >
                    <tr>
                      <td style="width: 80%;">Тухайн сарын төлбөр</td>
                      <td style="padding: 1px 0; text-align: end;">
                          <span t-out="'{:,.2f}'.format(total_amount)"/>
                      </td>
                    </tr>
                    <tr>
                      <td style="width: 80%;">Өмнөх сарын үлдэгдэл төлбөр</td>
                      <td style="padding: 1px 0; text-align: end;">
                          <span t-out="'{:,.2f}'.format(total_amount)"/>
                      </td>
                    </tr>
                  </table>

                <table
                    cellpadding="0"
                    cellspacing="0"
                    border="0"
                    style="
                      width: 100%;
                      border-collapse: collapse;
                      background: #fbb515;
                      border-radius: 12px;
                      overflow: hidden;
                      margin-bottom: 8px;
                      font-size: 14px;
                    "
                  >
                    <tr>
                      <td style="padding: 4px 15%; width: 59%; font-weight: bold;">
                          НИЙТ ТӨЛБӨР</td>
                      <td
                        style="
                          padding: 3px auto;
                          width: 41%;
                          text-align: center;
                          font-weight: bold;
                        "
                      >
                         <span t-out="'{:,.2f}'.format(total_amount)"/>
                      </td>
                    </tr>
                </table>
                <table
                    cellpadding="0"
                    cellspacing="0"
                    border="0"
                    style="width: 100%; font-size: 14px; border-collapse: collapse;"
                  >
                    <tr>
                      <td style="width: 52%; vertical-align: top;">
                        <table
                          cellpadding="0"
                          cellspacing="0"
                          border="0"
                          style="width: 100%; border-collapse: collapse"
                        >
                          <tr>
                            <td
                              style="
                                padding: 0 0 8px 0;
                                text-align: center;
                                font-weight: bold;
                              "
                            >
                              My gmobile аппликейшнаар төлбөр төлөх заавар
                            </td>
                          </tr>
                          <tr>
                            <td>
                                <img t-att-src="'data:image/png;base64,%s' % env.context.get('screen1_b64')" width="145px" alt=""/>
                                <img t-att-src="'data:image/png;base64,%s' % env.context.get('screen2_b64')" width="145px" alt=""/>
                                <img t-att-src="'data:image/png;base64,%s' % env.context.get('screen3_b64')" width="145px" alt=""/>
                            </td>
                          </tr>
                        </table>
                      </td>

                      <td style="width: 48%; padding: 0 0 0 10px; vertical-align: top">
                        <table
                          cellpadding="0"
                          cellspacing="0"
                          border="0"
                          style="width: 100%; border-collapse: collapse"
                        >
                          <tr>
                            <td
                              colspan="2"
                              style="
                                padding: 0 0 8px 0;
                                text-align: center;
                                font-weight: bold;
                              "
                            >
                              My gmobile аппликейшн татах
                            </td>
                          </tr>
                          <tr>
                            <td style="text-align: center">
                              <img t-att-src="'data:image/png;base64,%s' % env.context.get('app_b64')" width="170px" alt=""/>
                                <img t-att-src="'data:image/png;base64,%s' % env.context.get('qr_b64')"  style="padding: 4px;" width="150px" alt=""/>
                            </td>
                          </tr>
                        </table>
                      </td>
                    </tr>
                  </table>

               <table
                    cellpadding="0"
                    cellspacing="0"
                    border="0"
                    style="
                      width: 50%;
                      border-collapse: collapse;
                      font-size: 14px;
                      margin: 1% auto;
                    "
                  >
                    <tr>
                      <td
                        colspan="2"
                        style="
                          padding: 0 0 7px 0;
                          text-align: center;
                          font-weight: bold;
                        "
                      >
                        Төлбөр төлөх банкны данс
                      </td>
                    </tr>
                    <tr>
                      <td colspan="2" style="padding: 0 0 3px 0; font-weight: bold">
                        Харилцах данс:
                      </td>
                    </tr>
                    <tr>
                      <td style="padding: 1px 0 1px 20px">Голомт банк</td>
                      <td style="padding: 1px 0; text-align: right">
                        MN240015001501115008
                      </td>
                    </tr>
                    <tr>
                      <td style="padding: 1px 0 1px 20px">Төрийн банк</td>
                      <td style="padding: 1px 0; text-align: right">
                        MN960034100000223318
                      </td>
                    </tr>
                    <tr>
                      <td style="padding: 1px 0 5px 20px">Худалдаа хөгжлийн банк</td>
                      <td style="padding: 1px 0 5px 0; text-align: right">
                        MN170004000499129061
                      </td>
                    </tr>
                    <tr>
                      <td colspan="2" style="padding: 0 0 3px 0; font-weight: bold">
                        Автомат данс:
                      </td>
                    </tr>
                    <tr>
                      <td style="padding: 1px 0 1px 20px">Хаан банк</td>
                      <td style="padding: 1px 0; text-align: right">
                        MN740004005038006208
                      </td>
                    </tr>
                    <tr>
                      <td colspan="2" style="padding: 0 0 3px 0; font-weight: bold">
                        Хүлээн авагч:
                      </td>
                    </tr>
                    <tr>
                      <td style="padding: 1px 0 1px 20px">Гүйлгээний утга</td>
                      <td style="padding: 1px 0; text-align: right">
                        Утасны дугаараа заавал бичих
                      </td>
                    </tr>
                  </table>


            </main>

            <!-- Locked Bottom Footer -->
            <div class="footer-fixed">
                <table style="width: 100%; border-top: 2px solid #f6b500; font-size: 14px;">
                    <tr>
                        <td style="vertical-align: middle;">
                            <p style="margin-left: 12%; color: #4a4a4a;">Жимобайл ХХК</p>
                        </td>
                    </tr>
                    <tr>
                        <td style="vertical-align: middle;">
                            <p style="margin-left: 12%; color: #4a4a4a;">
                                Улаанбаатар хот, Сүхбаатар дүүрэг, 6-р хороо, НҮБ-ийн гудамж, Бага тойруу-14, МТ байр
                            </p>
                        </td>
                    </tr>
                    <tr>
                       <table
                            cellpadding="0"
                            cellspacing="0"
                            border="0"
                            style="
                                width: 50%;
                                border-collapse: collapse;
                                margin: 0 auto;
                                font-size: 8px;
                                table-layout: fixed;
                                font-size: 14px;
                            "
                        >
                            <tr>
                                <td style="width: 33.33%; white-space: nowrap; vertical-align: middle;">
                                    <table cellpadding="0" cellspacing="0" border="0">
                                        <tr>
                                            <td style="vertical-align: middle; padding-right: 5px;">
                                                <svg
                                                    xmlns="http://www.w3.org/2000/svg"
                                                    width="14"
                                                    height="14"
                                                    viewBox="0 -960 960 960"
                                                    fill="#f0d422"
                                                    style="display: block;"
                                                >
                                                    <path d="M838-65 720-183v89h-80v-226h226v80h-90l118 118-56 57ZM480-80q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54 54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 20-2 40t-6 40h-82q5-20 7.5-40t2.5-40q0-20-2.5-40t-7.5-40H654q3 20 4.5 40t1.5 40q0 20-1.5 40t-4.5 40h-80q3-20 4.5-40t1.5-40q0-20-1.5-40t-4.5-40H386q-3 20-4.5 40t-1.5 40q0 20 1.5 40t4.5 40h134v80H404q12 43 31 82.5t45 75.5q20 0 40-2.5t40-4.5v82q-20 2-40 4.5T480-80Z"/>
                                                </svg>
                                            </td>
                                            <td style=" vertical-align: middle;
                                                line-height: 18px;
                                                font-size: 10px;
                                                white-space: nowrap;">www.gmobile.mn</td>
                                        </tr>
                                    </table>
                                </td>

                                <td style="width: 33.33%; white-space: nowrap; vertical-align: middle;">
                                    <table cellpadding="0" cellspacing="0" border="0">
                                        <tr>
                                            <td style="vertical-align: middle; padding-right: 5px;">
                                               <svg xmlns="http://www.w3.org/2000/svg" height="14px" viewBox="0 -960 960 960" width="14px" style="display: block;" fill="#f0d422"><path d="M838-65 720-183v89h-80v-226h226v80h-90l118 118-56 57ZM480-80q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 20-2 40t-6 40h-82q5-20 7.5-40t2.5-40q0-20-2.5-40t-7.5-40H654q3 20 4.5 40t1.5 40q0 20-1.5 40t-4.5 40h-80q3-20 4.5-40t1.5-40q0-20-1.5-40t-4.5-40H386q-3 20-4.5 40t-1.5 40q0 20 1.5 40t4.5 40h134v80H404q12 43 31 82.5t45 75.5q20 0 40-2.5t40-4.5v82q-20 2-40 4.5T480-80ZM170-400h136q-3-20-4.5-40t-1.5-40q0-20 1.5-40t4.5-40H170q-5 20-7.5 40t-2.5 40q0 20 2.5 40t7.5 40Zm34-240h118q9-37 22.5-72.5T376-782q-55 18-99 54.5T204-640Zm172 462q-18-34-31.5-69.5T322-320H204q29 51 73 87.5t99 54.5Zm28-462h152q-12-43-31-82.5T480-798q-26 36-45 75.5T404-640Zm234 0h118q-29-51-73-87.5T584-782q18 34 31.5 69.5T638-640Z"/></svg>
                                            </td>
                                           <td style="
                                                vertical-align: middle;
                                                line-height: 18px;
                                                font-size: 10px;
                                                white-space: nowrap;
                                            ">
                                                3636,98103636
                                            </td>
                                        </tr>
                                    </table>
                                </td>

                                <td style="width: 33.33%; white-space: nowrap; vertical-align: middle;">
                                    <table cellpadding="0" cellspacing="0" border="0">
                                        <tr>
                                            <td style="vertical-align: middle; padding-right: 5px;">
                                                <svg
                                                    xmlns="http://www.w3.org/2000/svg"
