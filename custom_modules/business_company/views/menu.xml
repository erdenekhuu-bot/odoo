<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_billing_read_list" model="ir.ui.view">
        <field name="name">billing.read.list</field>
        <field name="model">billing.read</field>
        <field name="arch" type="xml">
            <list string="Billing Synchronization">
                <field name="acc_number"/>
                <field name="bill_id"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="total_amount"/>
                <field name="state"/>
                <button string="export pdf" name="action_test_email_campaign_bills" type="object" class="btn-primary"/>
            </list>
        </field>
    </record>
    <record id="action_billing_read_window" model="ir.actions.act_window">
        <field name="name">Төлбөрийн мэдээлэл (Billing)</field>
        <field name="res_model">billing.read</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="target">current</field>
    </record>

     <menuitem
             id="sync_billing_users"
             name="Synchronization"
             sequence="10"
             action="action_billing_read_window"
     />

     <record id="action_single_bill_mailings" model="ir.actions.act_window">
        <field name="name">Single Bill</field>
        <field name="res_model">mailing.mailing</field>
        <field name="view_mode">list,form,kanban,calendar</field>

        <field
            name="view_id"
            ref="mass_mailing.view_mail_mass_mailing_tree"
        />

        <field name="domain">
            [
                ('user_id.login', '=', 'bot@gmobile.mn')
            ]
        </field>
    </record>
    <menuitem id="email_custom_filter_billing" name="Single Bill" parent="mass_mailing.mass_mailing_menu_root" sequence="101" action="action_single_bill_mailings"/>

</odoo>