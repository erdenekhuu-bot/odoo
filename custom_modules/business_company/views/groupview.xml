<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="list_billing_group" model="ir.ui.view">
        <field name="name">billing.group.list</field>
        <field name="model">billing.group</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="acc_number"/>
            </list>
        </field>
    </record>
    <record id="form_billing_group" model="ir.ui.view">
        <field name="name">billing.group.form</field>
        <field name="model">billing.group</field>
        <field name="arch" type="xml">
            <form>
                <field name="name"/>
                <field name="acc_number"/>
            </form>
        </field>
    </record>
    <record id="action_billing_group" model="ir.actions.act_window">
        <field name="name">Billing group</field>
        <field name="res_model">billing.group</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
    </record>
    <menuitem id="menu_billing_group" name="Billing Groups" sequence="11" action="action_billing_group"/>
</odoo>