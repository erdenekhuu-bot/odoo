<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_sync_billing" model="ir.cron">
            <field name="name">Sync Billing From External DB</field>
            <field name="model_id" ref="model_billing_read"/>
            <field name="state">code</field>
            <field name="code">model.read_all()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="nextcall">2026-08-07 18:30:00</field>
<!--            <field name="active" eval="True"/>-->
            <field name="active">False</field>
        </record>
        <record id="ir_cron_read_account" model="ir.cron">
            <field name="name">Read Account (Billing)</field>
            <field name="model_id" ref="model_billing_read_account"/>
            <field name="state">code</field>
            <field name="code">model.sync_billing_account()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">False</field>
        </record>
         <record id="ir_cron_period" model="ir.cron">
            <field name="name">Period (Billing)</field>
            <field name="model_id" ref="model_billing_period"/>
            <field name="state">code</field>
            <field name="code">model.sync_billing_period()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">False</field>
        </record>
        <record id="ir_cron_billing_email_campaign" model="ir.cron">
            <field name="name">Initiate (Billing to email campaign)</field>
            <field name="model_id" ref="model_billing_read"/>
            <field name="state">code</field>
            <field name="code">model.initiate_action_campaign_bills()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="active">False</field>
        </record>
        <record id="ir_cron_billing_oracle_sync" model="ir.cron">
            <field name="name">GMobile: Sync Oracle Billing Data</field>
            <field name="model_id" ref="model_billing_oracle"/>
            <field name="state">code</field>
            <field name="code">model.cron_sync_billing()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">False</field>
        </record>
    </data>

</odoo>