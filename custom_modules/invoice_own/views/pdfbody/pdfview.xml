                        </div>
                      </div>

                      <div class="section-title">
                        <span>НИЙТ ТӨЛБӨР:</span>
                        <span>-2,286.27</span>
                      </div>
                    </section>

                    <!-- RIGHT -->
                    <section class="right-panel">
                      <div class="app-block">
                        <h2>My gmobile аппликейшн татах</h2>
                        <div class="qr-row">
                            <img t-att-src="'%s/jishee/static/src/img/appstoreqr.png' % base_url"/>
                            <img t-att-src="'%s/jishee/static/src/img/playstoreqr.png' % base_url"/>
                        </div>
                      </div>

                      <div class="guide-block">
                        <h2>My gmobile аппликейшнээр төлбөр төлөх заавар</h2>
                        <div class="guide-images">
                            <img t-att-src="'%s/jishee/static/src/img/screen1.jpg' % base_url" width="200"/>
                            <img t-att-src="'%s/jishee/static/src/img/screen2.jpg' % base_url" width="200"/>
                            <img t-att-src="'%s/jishee/static/src/img/screen3.jpg' % base_url" width="200"/>
                        </div>
                      </div>

                      <div class="bank-block">
