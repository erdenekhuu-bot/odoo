<odoo>
    <template id="pdfbody">
        <t t-call="web.html_container">
            <style>
               @page {
                  size: A4 portrait;
                  margin: 7mm 6mm 8mm 6mm;
                }

                @media print {
                  * {
                    box-sizing: border-box;
                    -webkit-print-color-adjust: exact !important;
                    print-color-adjust: exact !important;
                  }

                  html,
                  body {
                    background: #ffffff;
                    color: #111111;
                    font-family: Arial, Helvetica, sans-serif;
                  }

                  .invoice {
                    width: 198mm;
                    min-height: 281mm;
                    position: relative;
                  }

                  .invoice-header {
                    display: grid;
                    grid-template-columns: 1fr 34mm;
                    align-items: start;
                    column-gap: 6mm;
                    border-bottom: 1mm solid #e0a51b;
                    padding: 0 0 4mm 0;
                    margin: 0 0 2.5mm 0;
                  }

                  .invoice-header h1 {
                    margin: 1mm 0 0 0;
                    font-size: 11.5pt;
                    line-height: 1.05;
                    font-weight: 700;
                    letter-spacing: 0;
                  }

                  .logo {
                    width: 31mm;
                    height: auto;
                    display: block;
                    margin-left: auto;
                    margin-top: -0.5mm;
                  }

                  .invoice-main {
                    display: grid;
                    grid-template-columns: 1fr 1fr;
                    column-gap: 0;
                    align-items: start;
                  }

                  .left-panel {
                    padding-right: 6.5mm;
                    border-right: 0.5mm solid #d9a321;
                    min-height: 228mm;
                  }

                  .right-panel {
                    padding-left: 6.5mm;
                    min-height: 228mm;
                  }

                  .info-row {
                    display: grid;
                    grid-template-columns: 1fr 35mm;
                    column-gap: 4mm;
                    align-items: end;
                    padding: 1.05mm 0;
                    font-size: 8.8pt;
                    line-height: 1.1;
                  }

                  .info-row span {
                    font-weight: 400;
                  }

                  .info-row strong {
                    font-weight: 700;
                    text-align: right;
                  }

                  .table-section {
                    margin-top: 4.2mm;
                  }

                  .section-title {
                    background: #e0a51b !important;
                    color: #111111 !important;
                    display: flex;
                    align-items: center;
                    justify-content: space-between;
                    padding: 1.8mm 3.2mm 1.6mm 3.2mm;
                    font-size: 8.6pt;
                    line-height: 1;
                    font-weight: 700;
                  }

                  .section-title.single {
                    display: block;
                  }

                  .table-body {
                    border-left: 0.25mm solid #dddddd;
                    border-right: 0.25mm solid #dddddd;
                    border-bottom: 0.25mm solid #dddddd;
                    margin: 0;
                    padding: 0;
                  }

                  .summary-box {
                    border-left: 0.25mm solid #dddddd;
                    border-right: 0.25mm solid #dddddd;
                    border-bottom: 0.25mm solid #dddddd;
                    margin-top: 5.2mm;
                    padding: 0;
                  }

                  .table-row {
                    display: flex;
                    justify-content: space-between;
                    padding: 1.7mm 3.5mm;
                    font-size: 8.3pt;
                    line-height: 1.15;
                    border: none;
                  }

                  .table-row span:last-child {
                    text-align: right;
                    white-space: nowrap;
                  }

                  .table-row.bold {
                    font-weight: 700;
                    padding-top: 2.2mm;
                    padding-bottom: 1.4mm;
                  }

                  .table-row.total {
                    font-weight: 700;
                    padding-top: 2mm;
                    padding-bottom: 2mm;
                  }

                  .right-panel h2 {
                    margin: 0 0 3mm 0;
                    text-align: center;
                    font-size: 8.8pt;
                    line-height: 1.15;
                    font-weight: 700;
                  }

                  .app-block {
                    margin: 13mm 0 2mm 0;
                  }

                  .qr-row {
                    display: flex;
                    gap: 10;
                    justify-items: center;
                    margin-top: 1mm;
                  }

                  .qr-row img {
                    width: 33mm;
                    height: 33mm;
                    object-fit: contain;
                    display: block;
                  }

                  .guide-block {
                    margin-top: 3mm;
                  }

                  .guide-images {
                    /* display: grid;
                    grid-template-columns: repeat(3, 1fr);
                    column-gap: 2.5mm;
                    align-items: start; */
                    display: flex;
                    align-items: center;
                    gap: 5;
                  }

                  .guide-images img {
                    width: 100%;
                    height: 48mm;
                    object-fit: cover;
                    display: block;
                    border: none;
                  }

                  .bank-block {
                    margin-top: 6mm;
                  }

                  .bank-table,
                  .bank-extra {
                    margin-top: 1.2mm;
                  }

                  .bank-head,
                  .bank-row {
                    display: grid;
                    grid-template-columns: 33mm 1fr;
                    column-gap: 4mm;
                    padding: 0.9mm 0;
                    font-size: 8.2pt;
                    line-height: 1.15;
                    align-items: start;
                  }

                  .bank-head {
                    font-weight: 700;
                    padding-top: 0;
                    padding-bottom: 1mm;
                  }

                  .bank-row span:last-child,
                  .bank-head span:last-child {
                    text-align: left;
                    word-break: break-word;
                  }

                  .invoice-footer {
                    border-top: 0.25mm solid #d7d7d7;
                    padding-top: 3mm;
                    font-size: 7.9pt;
                    line-height: 1.2;
                  }

                  img {
                    page-break-inside: avoid;
                    break-inside: avoid;
                  }

                  .invoice-header,
                  .left-panel,
                  .right-panel,
                  .table-section,
                  .summary-box,
                  .app-block,
                  .guide-block,
                  .bank-block,
                  .invoice-footer {
                    page-break-inside: avoid;
                    break-inside: avoid;
                  }
                }

            </style>

              <div class="invoice">
