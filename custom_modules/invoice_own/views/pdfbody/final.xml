<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="paperformat_non_margin" model="report.paperformat">
        <field name="name">Zero Margin A4</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
    </record>

    <record id="final_report_pdf" model="ir.actions.report">
        <field name="name">Custom PDF Report</field>
        <field name="model">billing.read</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">invoice_own.demo_custom_template</field>
        <field name="report_file">invoice_own.demo_custom_template</field>
        <field name="binding_model_id" ref="model_billing_read"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_non_margin"/>
    </record>

