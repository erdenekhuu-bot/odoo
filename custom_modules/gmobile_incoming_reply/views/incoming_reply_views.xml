<odoo>

    <record id="reply_action" model="ir.actions.server">
        <field name="name">Reply back to customer</field>
        <field name="model_id" ref="model_gmobile_incoming_reply"/>
        <field name="binding_model_id" ref="model_gmobile_incoming_reply"/>
        <field name="binding_view_types">form,list</field>
        <field name="state">code</field>
        <field name="code">
            action = records.action_back_reply()
        </field>
    </record>


    <record id="view_incoming_reply_list" model="ir.ui.view">
        <field name="name">gmobile.incoming.reply.list</field>
        <field name="model">gmobile.incoming.reply</field>
        <field name="arch" type="xml">
            <list string="Incoming Replies">
                <field name="received_date"/>
                <field name="email_from"/>
                <field name="subject"/>
            </list>
        </field>
    </record>

    <record id="view_incoming_reply_form" model="ir.ui.view">
        <field name="name">gmobile.incoming.reply.form</field>
        <field name="model">gmobile.incoming.reply</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="%(reply_action)d"
                        string="Reply back"
                        type="action"
                        class="btn-primary"/>
<!--                     <button name="click_button" string="Reply to Customer" type="object" class="btn-primary"/>-->
                </header>
                <sheet>
                    <group>
                        <field name="email_from"/>
                        <field name="subject"/>
                        <field name="received_date"/>
                        <field name="body_preview"/>
                        <field name="reply_body" placeholder="Type your reply here..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_incoming_reply" model="ir.actions.act_window">
        <field name="name">Replies</field>
        <field name="res_model">gmobile.incoming.reply</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_incoming_reply_root" name="Gmobile Email Replies" sequence="90"/>
    <menuitem id="menu_incoming_reply" parent="menu_incoming_reply_root" action="action_incoming_reply" sequence="1"/>
</odoo>