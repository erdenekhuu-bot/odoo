<odoo>
    <record id="view_incoming_reply_list" model="ir.ui.view">
        <field name="name">gmobile.incoming.reply.list</field>
        <field name="model">gmobile.incoming.reply</field>
        <field name="arch" type="xml">
            <list string="Incoming Replies">
                <field name="received_date"/>
                <field name="email_from"/>
                <field name="subject"/>
                <field name="body_preview"/>
            </list>
        </field>
    </record>

    <record id="view_incoming_reply_form" model="ir.ui.view">
        <field name="name">gmobile.incoming.reply.form</field>
        <field name="model">gmobile.incoming.reply</field>
        <field name="arch" type="xml">
            <form string="Incoming Reply">
                <sheet>
                    <group>
                        <field name="email_from"/>
                        <field name="subject"/>
                        <field name="received_date"/>
                    </group>
                    <field name="body_preview"/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_incoming_reply" model="ir.actions.act_window">
        <field name="name">Replies</field>
        <field name="res_model">gmobile.incoming.reply</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_incoming_reply_root" name="Gmobile Email Replies" sequence="90"/>
    <menuitem id="menu_incoming_reply" parent="menu_incoming_reply_root" action="action_incoming_reply" sequence="1"/>
</odoo>