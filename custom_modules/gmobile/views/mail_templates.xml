<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="gmobile_invoice_email_body">
        <div style="font-family: Arial, sans-serif; background:#f5f7fb; padding:24px;">
            <table width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:520px; margin:0 auto; background:#ffffff; border:1px solid #e5e7eb; border-radius:12px;">
                <tr>
                    <td style="padding:24px;">
                        <h2 style="margin:0 0 8px 0; font-size:22px; color:#1f2937;">
                            Gmobile Invoice Dashboard
                        </h2>

                        <p style="margin:0 0 16px 0; font-size:14px; color:#6b7280;">
                            Системээс автоматаар үүсгэсэн мэдээлэл
                        </p>

                        <div style="margin-bottom:20px; padding:12px 16px; background:#eff6ff; border-radius:8px; color:#1d4ed8; font-size:14px;">
                            Нийт: <strong><t t-esc="total"/></strong>
                        </div>

                        <t t-if="items">
                            <ul style="margin:0; padding-left:18px; color:#374151; font-size:14px; line-height:22px;">
                                <t t-foreach="items" t-as="item">
                                    <li style="margin-bottom:8px;">
                                        <t t-esc="item.get('title')"/>
                                    </li>
                                </t>
                            </ul>
                        </t>

                        <t t-else="">
                            <p style="margin:0; font-size:14px; color:#9ca3af;">
                                Өгөгдөл олдсонгүй.
                            </p>
                        </t>
                    </td>
                </tr>
            </table>
        </div>
    </template>
</odoo>