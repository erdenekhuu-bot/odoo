<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="model_profile_list" model="ir.ui.view">
        <field name="name">demo.profile.list</field>
        <field name="model">demo.profile</field>
        <field name="arch" type="xml">
            <list string="read record">
                <field name="name"></field>
                <field name="age"></field>
                <field name="email"></field>
                <field name="is_active"></field>
            </list>
        </field>
    </record>

    <record id="model_profile_form" model="ir.ui.view">
        <field name="name">demo.profile.form</field>
        <field name="model">demo.profile</field>
        <field name="arch" type="xml">
            <form string="create record">
                <sheet>
                    <group>
                        <field name="name"></field>
                        <field name="age"></field>
                        <field name="email"></field>
                        <field name="is_active"></field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>