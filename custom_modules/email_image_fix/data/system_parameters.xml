<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Force HTTPS and correct domain -->
    <record id="base_url_param" model="ir.config_parameter">
        <field name="key">web.base.url</field>
        <field name="value">https://massmail.gmobile.mn</field>
    </record>
    <record id="secure_param" model="ir.config_parameter">
        <field name="key">web.secure.force</field>
        <field name="value">True</field>
    </record>
</odoo>