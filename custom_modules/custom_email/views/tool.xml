<odoo>
    <!-- Top-level menu -->
    <menuitem id="menu_root" name="Demo App" />

    <!-- Action that opens a website -->
    <record id="action_google" model="ir.actions.act_url">
        <field name="name">Open Google</field>
        <field name="url">https://google.com</field>
        <field name="target">new</field>
    </record>

    <!-- Menu item for the action -->
    <menuitem 
        id="menu_google" 
        name="Google" 
        action="action_google" 
        parent="menu_root" 
    />
</odoo>